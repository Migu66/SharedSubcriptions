{
  "ConnectionStrings": {
    "NotificationsDb": "Server=localhost,1433;Database=SharedSubscriptions_Notifications;User Id=sa;Password=YourStrong!Passw0rd;TrustServerCertificate=True;"
  },
  "RabbitMq": {
    "Host": "localhost",
    "VirtualHost": "/",
    "Username": "guest",
    "Password": "guest"
  },
  "Jwt": {
    "Secret": "dev-secret-key-change-in-production-min32chars",
    "Issuer": "SharedSubscriptions",
    "Audience": "SharedSubscriptions.Api",
    "ExpiryMinutes": 60
  },
  "Notifications": {
    "SendGrid": {
      "ApiKey": "SG.your_sendgrid_api_key_here",
      "FromEmail": "noreply@sharedsubscriptions.dev",
      "FromName": "SharedSubscriptions"
    },
    "Telegram": {
      "BotToken": "your_telegram_bot_token_here"
    },
    "WhatsApp": {
      "AccessToken": "your_whatsapp_access_token_here",
      "PhoneNumberId": "your_phone_number_id_here"
    },
    "Firebase": {
      "CredentialPath": "firebase-credentials.json"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "MassTransit": "Debug"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": { "serverUrl": "http://localhost:5341" }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  }
}
