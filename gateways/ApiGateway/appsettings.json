{
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Yarp": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "JwtSettings": {
    "SecretKey": "",
    "Issuer": "SharedSubscriptions",
    "Audience": "SharedSubscriptions.Api"
  },
  "ReverseProxy": {
    "Routes": {
      "identity-route-auth": {
        "ClusterId": "identity-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "identity-route-users": {
        "ClusterId": "identity-cluster",
        "AuthorizationPolicy": "AuthenticatedUser",
        "Match": { "Path": "/api/users/{**catch-all}" }
      },
      "groups-route": {
        "ClusterId": "groups-cluster",
        "AuthorizationPolicy": "AuthenticatedUser",
        "Match": { "Path": "/api/groups/{**catch-all}" }
      },
      "subscriptions-route": {
        "ClusterId": "subscriptions-cluster",
        "AuthorizationPolicy": "AuthenticatedUser",
        "Match": { "Path": "/api/subscriptions/{**catch-all}" }
      },
      "payments-route": {
        "ClusterId": "payments-cluster",
        "AuthorizationPolicy": "AuthenticatedUser",
        "Match": { "Path": "/api/payments/{**catch-all}" }
      },
      "analytics-route": {
        "ClusterId": "analytics-cluster",
        "AuthorizationPolicy": "AuthenticatedUser",
        "Match": { "Path": "/api/analytics/{**catch-all}" }
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://identity-service:8080" }
        }
      },
      "groups-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://groups-service:8080" }
        }
      },
      "subscriptions-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://subscriptions-service:8080" }
        }
      },
      "payments-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://payments-service:8080" }
        }
      },
      "analytics-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://analytics-service:8080" }
        }
      }
    }
  }
}
