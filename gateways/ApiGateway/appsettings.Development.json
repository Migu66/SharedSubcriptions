{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Yarp": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": { "serverUrl": "http://localhost:5341" }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "JwtSettings": {
    "SecretKey": "dev-secret-key-change-in-production-min32chars",
    "Issuer": "SharedSubscriptions",
    "Audience": "SharedSubscriptions.Api"
  },
  "ReverseProxy": {
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5001" }
        }
      },
      "groups-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5014" }
        }
      },
      "subscriptions-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5002" }
        }
      },
      "payments-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5003" }
        }
      },
      "analytics-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5005" }
        }
      }
    }
  }
}
