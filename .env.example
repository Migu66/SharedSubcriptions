# ============================================================
# SharedSubscriptions — Variables de entorno
# Copia este archivo como .env y rellena los valores reales.
# El archivo .env NUNCA se sube al repositorio (está en .gitignore).
# ============================================================

# --- SQL Server ---
SA_PASSWORD=YourStrong!Passw0rd

# --- Groups Service ---
GROUPS_DB_CONNECTION=Server=sqlserver,1433;Database=SharedSubscriptions_Groups;User Id=sa;Password=YourStrong!Passw0rd;TrustServerCertificate=True;

# --- RabbitMQ ---
RABBITMQ_HOST=rabbitmq
RABBITMQ_VIRTUAL_HOST=/
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# --- JWT ---
JWT_SECRET=cambia_esto_por_una_clave_secreta_de_al_menos_32_caracteres
JWT_ISSUER=SharedSubscriptions
JWT_AUDIENCE=SharedSubscriptions.Clients
JWT_EXPIRY_MINUTES=60
