# =============================================================================
# SharedSubscriptions — Variables de entorno
# =============================================================================
# Copia este archivo como ".env" y rellena los valores reales.
# NUNCA subas el archivo .env al repositorio (está en .gitignore).
# =============================================================================

# ── SQL Server ────────────────────────────────────────────────────────────────
# Debe cumplir la política de SQL Server: mínimo 8 caracteres,
# con mayúsculas, minúsculas, números y símbolos.
SA_PASSWORD=YourStrong!Passw0rd

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
RABBITMQ_USER=admin
RABBITMQ_PASS=admin123

# ── JWT ───────────────────────────────────────────────────────────────────────
# Clave secreta para firmar los tokens JWT. Mínimo 32 caracteres.
JWT_SECRET=cambia-esto-por-una-clave-secreta-de-al-menos-32-caracteres

# ── Stripe ────────────────────────────────────────────────────────────────────
# Clave secreta de Stripe (sk_test_ en pruebas, sk_live_ en producción).
STRIPE_SECRET_KEY=sk_test_...
# Secreto del webhook de Stripe para verificar los eventos entrantes.
STRIPE_WEBHOOK_SECRET=whsec_...

# ── SendGrid ──────────────────────────────────────────────────────────────────
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=noreply@sharedsubscriptions.com

# ── Telegram ──────────────────────────────────────────────────────────────────
# Token del bot de Telegram obtenido desde @BotFather.
TELEGRAM_BOT_TOKEN=123456789:AABBCCDDEEFFaabbccddeeff-xxxxxxxxxxxxxxx

# ── WhatsApp Business API ─────────────────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=1234567890

# ── Firebase Admin SDK ────────────────────────────────────────────────────────
# Ruta local al JSON de credenciales de la cuenta de servicio de Firebase.
# Descárgalo desde Firebase Console → Configuración del proyecto → Cuentas de servicio.
FIREBASE_CREDENTIALS_PATH=/ruta/a/firebase-credentials.json

# ── Build móvil Android (firma del APK/AAB) ───────────────────────────────────
ANDROID_SIGNING_KEY_PASS=tu-clave-de-firma
ANDROID_SIGNING_STORE_PASS=tu-contraseña-del-keystore
