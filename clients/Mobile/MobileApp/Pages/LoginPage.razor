@page "/login"
@using MobileApp.Services
@inject MobileAuthService AuthService
@inject NavigationManager Navigation

<div class="login-page">

    <!-- Cabecera oscura con logo -->
    <div class="login-page__header">
        <div class="login-page__logo" aria-hidden="true">S</div>
        <h1 class="login-page__title">SharedSubscriptions</h1>
        <p class="login-page__tagline">Gestiona tus suscripciones compartidas</p>
    </div>

    <!-- Formulario -->
    <div class="login-page__form-area">
        <EditForm Model="model" OnValidSubmit="HandleLoginAsync" FormName="mobile-login">
            <DataAnnotationsValidator />

            <div class="form-group">
                <label for="email">Email</label>
                <InputText id="email"
                           @bind-Value="model.Email"
                           type="email"
                           class="form-input"
                           placeholder="tu@email.com"
                           autocomplete="email"
                           inputmode="email" />
                <ValidationMessage For="() => model.Email" />
            </div>

            <div class="form-group">
                <label for="password">Contraseña</label>
                <InputText id="password"
                           @bind-Value="model.Password"
                           type="password"
                           class="form-input"
                           placeholder="••••••••"
                           autocomplete="current-password" />
                <ValidationMessage For="() => model.Password" />
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="error-alert" role="alert">@errorMessage</div>
            }

            <button type="submit" class="btn-login" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="btn-login__spinner"></span>
                    <span>Entrando...</span>
                }
                else
                {
                    <span>Entrar</span>
                }
            </button>
        </EditForm>
    </div>
</div>

@code {
    private readonly LoginModel model = new();
    private string? errorMessage;
    private bool isLoading;

    protected override async Task OnInitializedAsync()
    {
        // Si ya está autenticado, redirigir al inicio
        if (await AuthService.IsAuthenticatedAsync())
            Navigation.NavigateTo("/", replace: true);
    }

    private async Task HandleLoginAsync()
    {
        isLoading = true;
        errorMessage = null;

        var success = await AuthService.LoginAsync(model.Email, model.Password);

        if (success)
        {
            Navigation.NavigateTo("/", replace: true);
        }
        else
        {
            errorMessage = "Email o contraseña incorrectos. Inténtalo de nuevo.";
            isLoading = false;
        }
    }

    private sealed class LoginModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "El email es obligatorio.")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "Formato de email no válido.")]
        public string Email { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "La contraseña es obligatoria.")]
        public string Password { get; set; } = string.Empty;
    }
}
