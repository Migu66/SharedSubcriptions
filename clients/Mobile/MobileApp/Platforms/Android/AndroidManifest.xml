<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/appicon"
        android:roundIcon="@mipmap/appicon_round"
        android:supportsRtl="true"
        android:label="SharedSubscriptions"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- Canal por defecto para notificaciones FCM en Android 8+.
             Debe coincidir con AppFirebaseMessagingService.ChannelId -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="shared_subscriptions_channel" />

        <!-- Icono y color del sistema para notificaciones FCM -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@mipmap/appicon" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/colorPrimary" />
    </application>

    <!-- Permisos necesarios -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- POST_NOTIFICATIONS obligatorio en Android 13+ para mostrar notificaciones push -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
