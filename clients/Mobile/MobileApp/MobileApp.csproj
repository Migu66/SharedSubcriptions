<Project Sdk="Microsoft.NET.Sdk.Maui">

  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-ios;net10.0-windows10.0.19041.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>MobileApp</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Metadatos de la aplicación -->
    <ApplicationTitle>SharedSubscriptions</ApplicationTitle>
    <ApplicationId>com.sharedsubscriptions.app</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <!-- Versiones mínimas de plataforma -->
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">26.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
  </PropertyGroup>

  <!-- Recursos visuales de MAUI -->
  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#e94560" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#1a1a2e" BaseSize="128,128" />
    <MauiFont Include="Resources\Fonts\*" />
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Paquetes NuGet base -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
  </ItemGroup>

  <!-- Firebase Cloud Messaging solo en plataformas móviles -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-android' OR '$(TargetFramework)' == 'net10.0-ios'">
    <PackageReference Include="Plugin.Firebase.CloudMessaging" Version="3.0.3" />
  </ItemGroup>

  <!-- Archivos de configuración de Firebase por plataforma -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-android'">
    <GoogleServicesJson Include="Platforms\Android\google-services.json" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-ios'">
    <BundleResource Include="Platforms\iOS\GoogleService-Info.plist" />
  </ItemGroup>

  <!-- Referencia a la Razor Class Library compartida -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\shared\RazorComponents\SharedUI\SharedUI.csproj" />
  </ItemGroup>

  <!-- ── Configuración de build de RELEASE para Android (Google Play Store) ─────── -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <!-- AAB para Google Play Store; cambiar a 'apk' para distribución directa (sideload) -->
    <AndroidPackageFormat>aab</AndroidPackageFormat>
    <!-- Firma del bundle. Las contraseñas se leen de variables de entorno en CI/CD.
         Para build local: exportar ANDROID_SIGNING_KEY_PASS y ANDROID_SIGNING_STORE_PASS. -->
    <AndroidKeyStore>true</AndroidKeyStore>
    <AndroidSigningKeyStore>Platforms\Android\sharedsubscriptions.keystore</AndroidSigningKeyStore>
    <AndroidSigningKeyAlias>sharedsubscriptions</AndroidSigningKeyAlias>
    <AndroidSigningKeyPass>$(ANDROID_SIGNING_KEY_PASS)</AndroidSigningKeyPass>
    <AndroidSigningStorePass>$(ANDROID_SIGNING_STORE_PASS)</AndroidSigningStorePass>
  </PropertyGroup>

  <!-- ── Configuración de build de RELEASE para iOS (App Store / TestFlight) ────── -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <!-- Genera el archivo .xcarchive listo para subir a App Store Connect -->
    <ArchiveOnBuild>true</ArchiveOnBuild>
    <CodesignEntitlements>Platforms\iOS\Entitlements.plist</CodesignEntitlements>
    <!-- CodesignKey y CodesignProvision se configuran en CI/CD (Xcode Cloud, GitHub Actions)
         o manualmente en Visual Studio for Mac / JetBrains Rider. -->
  </PropertyGroup>

  <!-- ── Entitlements en DEBUG iOS (necesario para push en dispositivo físico) ───── -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <CodesignEntitlements>Platforms\iOS\Entitlements.plist</CodesignEntitlements>
  </PropertyGroup>

</Project>
